# Copy to .env (never commit it). Every variable is optional; the defaults run 100% locally.
RAG_PROVIDER=ollama                 # ollama | gemini | stub
RAG_MODEL=qwen3:4b                  # gemini-3.5-flash for gemini
OLLAMA_HOST=http://127.0.0.1:11434  # loopback only unless the next line is 1
RAG_ALLOW_REMOTE_OLLAMA=
RAG_STORE=local                     # local | vertex
RAG_INDEX_DIR=                      # default ~/.cache/adk-vertex-vector-search
RAG_INDEX=flat                      # flat (exact) | hnsw (approximate), local store only
RAG_EMBEDDER=fastembed              # fastembed | ollama | hash | vertex (hash for the stub)
RAG_EMBED_MODEL=                    # BAAI/bge-small-en-v1.5 | nomic-embed-text | gemini-embedding-001
RAG_MAX_HOPS=3                      # searches per question
RAG_TOP_K=5                         # passages per search
RAG_ALPHA=0.5                       # RRF weight of dense vs sparse (1 = dense only, 0 = sparse only)
RAG_PER_DOCUMENT=2                  # crowding: passages per document per search
# Only for RAG_STORE=vertex or RAG_EMBEDDER=vertex - PAID Google Cloud services, your bill.
# See docs/vertex-setup.md. Credentials come from `gcloud auth application-default login`.
# RAG_VERTEX_PROJECT=
# RAG_VERTEX_LOCATION=us-central1
# RAG_VERTEX_INDEX=
# RAG_VERTEX_INDEX_ENDPOINT=
# RAG_VERTEX_DEPLOYED_INDEX=docs_deployed
# RAG_VERTEX_ENDPOINT_DOMAIN=
# RAG_EMBED_DIMENSIONS=768
# Only for the optional Gemini provider (your key, your bill):
# GOOGLE_API_KEY=
